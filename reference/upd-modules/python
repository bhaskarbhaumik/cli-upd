if command -v pip3 &>/dev/null; then
    if command -v jq &>/dev/null; then
        # pip3 install --upgrade pip
        # pip3 list --outdated --format=json | jq -r '.[].name' | xargs -n1 pip3 install -U
        python3 -m pip install --upgrade pip
        python3 -m pip install $(python3 -m pip list --outdated --format=columns | awk 'NR>2 {print $1"=="$3}')
		fi
fi
if command -v pyenv &>/dev/null; then
    pyenv versions
    cur_ver=$(pyenv version 2>/dev/null | cut -d' ' -f1 2>/dev/null)
    lat_ver=$(pyenv latest -k 3.11 2>/dev/null)
    if [ ! "P${cur_ver}" = "P${lat_ver}" ]; then
        pyenv install "${lat_ver}"
        pyenv global "${lat_ver}"
        command -v pyenv-migrate &>/dev/null && brew install pyenv-pip-migrate
        pyenv migrate "${cur_ver}" "${lat_ver}"
        pyenv virtualenv -u "${lat_ver}" default
        pyenv uninstall -f "${cur_ver}"
    fi
fi
